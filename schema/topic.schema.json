{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "topic.schema.json",
  "title": "Topic",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "status", "tags"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "status.schema.json"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "currentAssessment": {
      "type": "string"
    },
    "reevaluationTriggers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
